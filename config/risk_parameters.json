{
  "_metadata": {
    "description": "Risk Parameters for ZAID Personal Crypto Trading Bot",
    "version": "1.0.0",
    "last_updated": "2024-01-01",
    "domains_integrated": [
      "Portfolio Theory",
      "Risk Management",
      "Kelly Criterion",
      "Value at Risk (VaR)",
      "Drawdown Control",
      "Position Sizing",
      "Correlation Analysis"
    ]
  },
  "kelly_criterion": {
    "description": "Kelly Criterion for optimal position sizing based on win rate and payoff ratio",
    "enabled": true,
    "multiplier": 0.25,
    "max_kelly_fraction": 0.5,
    "min_kelly_fraction": 0.01,
    "calculation_window_trades": 100,
    "adaptive_adjustment": true,
    "parameters": {
      "win_rate_threshold": 0.55,
      "payoff_ratio_min": 1.5,
      "risk_free_rate_annual": 0.03
    }
  },
  "value_at_risk": {
    "description": "Value at Risk calculations for portfolio risk assessment",
    "enabled": true,
    "confidence_level": 0.99,
    "time_horizon_days": 1,
    "method": "historical",
    "alternative_methods": ["parametric", "monte_carlo"],
    "parameters": {
      "lookback_period_days": 252,
      "decay_factor": 0.94,
      "minimum_observations": 100
    },
    "limits": {
      "max_var_percent_portfolio": 2.0,
      "max_var_absolute_usd": 500
    }
  },
  "drawdown_limits": {
    "description": "Strict drawdown controls to prevent catastrophic losses",
    "enabled": true,
    "max_daily_drawdown_percent": 2.0,
    "max_weekly_drawdown_percent": 5.0,
    "max_monthly_drawdown_percent": 10.0,
    "max_consecutive_losses": 5,
    "cooling_off_period_minutes": 30,
    "actions": {
      "on_daily_breach": "halt_trading",
      "on_weekly_breach": "halt_trading_day",
      "on_monthly_breach": "halt_trading_week",
      "on_consecutive_losses": "reduce_position_size"
    },
    "recovery_parameters": {
      "require_profitable_trades": 3,
      "gradual_ramp_up": true,
      "ramp_up_steps": 5
    }
  },
  "position_sizing": {
    "description": "Dynamic position sizing based on risk parameters",
    "method": "kelly_adjusted",
    "base_position_percent": 0.02,
    "max_position_percent_single_asset": 0.10,
    "max_position_percent_total": 0.50,
    "min_position_usd": 10,
    "max_position_usd": 5000,
    "scaling_rules": {
      "scale_in_levels": 3,
      "scale_out_levels": 3,
      "level_spacing_percent": 1.0
    },
    "asset_specific_limits": {
      "BTC": {
        "max_position_percent": 0.15,
        "max_position_usd": 10000
      },
      "ETH": {
        "max_position_percent": 0.12,
        "max_position_usd": 7500
      },
      "SOL": {
        "max_position_percent": 0.08,
        "max_position_usd": 5000
      }
    }
  },
  "correlation_limits": {
    "description": "Controls for portfolio correlation to prevent overexposure",
    "enabled": true,
    "max_portfolio_correlation": 0.7,
    "correlation_lookback_days": 30,
    "rebalance_threshold": 0.8,
    "assets": ["BTC", "ETH", "SOL"],
    "actions": {
      "on_high_correlation": "reduce_exposure",
      "reduction_factor": 0.5
    }
  },
  "leverage_controls": {
    "description": "Leverage management for risk mitigation",
    "enabled": false,
    "max_leverage_default": 1,
    "max_leverage_by_asset": {
      "BTC": 3,
      "ETH": 3,
      "SOL": 2
    },
    "margin_call_threshold": 0.8,
    "liquidation_buffer": 0.15,
    "auto_deleverage": true
  },
  "stop_loss_parameters": {
    "description": "Automated stop-loss configuration",
    "enabled": true,
    "type": "trailing",
    "initial_stop_percent": 2.0,
    "trailing_stop_percent": 1.5,
    "breakeven_trigger_percent": 1.0,
    "time_based_exit_hours": 4,
    "volatility_adjusted": true,
    "atr_multiplier": 2.0
  },
  "take_profit_parameters": {
    "description": "Take-profit configuration for locking gains",
    "enabled": true,
    "targets": [
      {
        "level": 1,
        "percent": 2.0,
        "close_fraction": 0.33
      },
      {
        "level": 2,
        "percent": 4.0,
        "close_fraction": 0.33
      },
      {
        "level": 3,
        "percent": 6.0,
        "close_fraction": 0.34
      }
    ],
    "trailing_after_target": true
  },
  "liquidity_requirements": {
    "description": "Minimum liquidity thresholds for safe execution",
    "min_order_book_depth_usd": 100000,
    "min_24h_volume_usd": 10000000,
    "max_slippage_percent": 0.5,
    "spread_threshold_bps": 10
  },
  "circuit_breakers": {
    "description": "Emergency halt mechanisms for extreme conditions",
    "enabled": true,
    "triggers": {
      "rapid_price_move_percent": 5.0,
      "rapid_price_move_window_seconds": 60,
      "exchange_error_rate_threshold": 0.1,
      "latency_threshold_ms": 1000,
      "ram_usage_threshold_percent": 95
    },
    "actions": {
      "on_trigger": "immediate_halt",
      "close_open_positions": false,
      "notification_channels": ["log", "console"]
    }
  },
  "performance_metrics": {
    "description": "Key performance indicators for risk-adjusted returns",
    "target_sharpe_ratio": 2.0,
    "target_sortino_ratio": 3.0,
    "target_calmar_ratio": 1.5,
    "max_turnover_daily": 10.0,
    "evaluation_period_days": 30
  }
}
